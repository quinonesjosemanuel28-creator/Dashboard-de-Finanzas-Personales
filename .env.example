# Base de datos (en Railway: referencia a la variable DATABASE_URL del servicio Postgres)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/patrimonio"

# Auth.js — generá el secreto con: npx auth secret  (o: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URL pública. En Railway no hace falta: se toma de RAILWAY_PUBLIC_DOMAIN (la define Railway).
# Cargala solo con un dominio propio. En local no hace falta (usa http://localhost:3000).
# AUTH_URL="https://tu-dominio.com"

# Único email que puede entrar
ALLOWED_EMAIL=""

# Zona horaria del servidor
TZ="America/Argentina/Buenos_Aires"
