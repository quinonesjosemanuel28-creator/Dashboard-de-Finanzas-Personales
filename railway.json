{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": ["npm run db:deploy && npm run db:seed"],
    "startCommand": "npm run start",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
